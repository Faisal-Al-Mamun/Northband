# Copy to .env:  cp .env.example .env   (Windows: Copy-Item .env.example .env)
# Compose overrides DATABASE_URL / REDIS_URL to service hostnames.
# Host mode (API on your machine): keep the localhost URLs below.
# No GPU required. Use LF line endings.

# Database
DATABASE_URL=postgresql+asyncpg://northband:northband@localhost:5432/northband
DATABASE_URL_SYNC=postgresql+psycopg://northband:northband@localhost:5432/northband

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080
ENVIRONMENT=development

# CORS
CORS_ORIGINS=http://localhost:3000

# Uploads
UPLOAD_DIR=./uploads

# LLM routing — set at least one provider
LLM_DEFAULT_PROVIDER=openrouter
LLM_DEFAULT_MODEL=openai/gpt-4o-mini
# Optional cheaper model for grammar, performance, and explain (skip unused calls anyway).
# LLM_CHEAP_PROVIDER=gemini
# LLM_CHEAP_MODEL=gemini-2.0-flash

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=https://api.openai.com/v1
OPENAI_COMPAT_MODEL=gpt-4o-mini

# Speech-to-text — local faster-whisper first (no API cost). Cloud is fallback only.
STT_PROVIDER=auto
WHISPER_MODEL=base
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_WARMUP_ON_START=false

# Optional per-agent overrides (provider:model)
# AGENT_WRITING=openrouter:openai/gpt-4o-mini
# AGENT_SPEAKING=gemini:gemini-2.0-flash
# AGENT_GRAMMAR=openai_compat:gpt-4o-mini
# AGENT_SCORING=openrouter:openai/gpt-4o-mini
# AGENT_FEEDBACK=openrouter:openai/gpt-4o-mini
# AGENT_PERFORMANCE=openrouter:openai/gpt-4o-mini
# AGENT_REVISION=openrouter:openai/gpt-4o-mini
# AGENT_EXPLAIN=openrouter:openai/gpt-4o-mini
# AGENT_COACH=openrouter:openai/gpt-4o-mini
# AGENT_BANK=openrouter:openai/gpt-4o-mini

# Scoring LLM is off by default; bands come from deterministic half-band math.
SCORING_LLM_ENABLED=false
# Reading/Listening wrong-item explanations (batched + cached). Disable to skip LLM.
EXPLAIN_LLM_ENABLED=true
LLM_TIMEOUT_SECONDS=45

# Listening audio: auto = Pocket TTS if installed, else macOS say. Never sine tones.
TTS_ENGINE=auto
TTS_WARMUP_ON_START=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
